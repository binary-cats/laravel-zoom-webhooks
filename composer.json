{
    "name": "binary-cats/laravel-zoom-webhooks",
    "description": "Handle Zoom.us webhooks in a Laravel application",
    "keywords": [
        "binary-cats",
        "laravel",
        "zoom",
        "zoom.us",
        "webhooks"
    ],
    "homepage": "https://github.com/binary-cats/laravel-zoom-webhooks",
    "license": "MIT",
    "authors": [
        {
            "name": "Cyrill Kalita",
            "email": "cyrill.kalita@gmail.com",
            "homepage": "https://github.com/binary-cats",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/support": "^8.0|^9.0|^10.0|^11.0|^12.0|^13.0",
        "spatie/laravel-webhook-client": "^3.0"
    },
    "require-dev": {
        "orchestra/testbench": "^6.0|^7.0|^8.0|^9.0|^10.0|^11.0"
    },
    "autoload": {
        "psr-4": {
            "BinaryCats\\ZoomWebhooks\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "BinaryCats\\ZoomWebhooks\\Tests\\": "tests"
        }
    },
    "suggest": {
        "binary-cats/laravel-bigbluebutton-webhooks": "Handle bigbluebutton webhooks in your Laravel application",
        "binary-cats/laravel-lob-webhooks": "Handle lob.com webhooks in your Laravel application",
        "binary-cats/laravel-mailgun-webhooks": "Handle mailgun.com webhooks in your Laravel application"
    },
    "scripts": {
        "test": "vendor/bin/phpunit"
    },
    "config": {
        "sort-packages": true
    },
    "extra": {
        "branch-alias": {
            "dev-master": "2.x-dev"
        },
        "laravel": {
            "providers": [
                "BinaryCats\\ZoomWebhooks\\ZoomWebhooksServiceProvider"
            ]
        }
    }
}
